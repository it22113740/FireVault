# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used to create sales admin logins and save applications.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site, used in password-reset links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile for /apply. Without these, verification is skipped in
# development and /apply refuses submissions in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend, for emailing denied applicants. Optional: without it, denials are
# saved but the applicant is not emailed.
RESEND_API_KEY=
EMAIL_FROM=FireVault <no-reply@example.com>

# Only read by scripts/seed-super-admin.ts
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=
