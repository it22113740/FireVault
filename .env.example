# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used to create sales admin logins and save applications.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site, used in password-reset links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.suban23.com

# Cloudflare Turnstile for /apply. Without these, verification is skipped in
# development and /apply refuses submissions in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend, for new application notifications to active super admin profile
# emails and for emailing denied applicants. Without it, applications and
# denials are saved but notification emails are not sent.
RESEND_API_KEY=
EMAIL_FROM=FireVault <no-reply@example.com>

# Only read by scripts/seed-super-admin.mts
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=

# Twilio WhatsApp, for new top-up order alerts to the admin WhatsApp number
# in /admin/settings. Without these, orders are saved and emailed (Resend)
# but no WhatsApp is sent. TWILIO_WHATSAPP_FROM is your WhatsApp sender, e.g.
# whatsapp:+14155238886 (Sandbox). TWILIO_ORDER_TEMPLATE_SID is the approved
# Content template ("HX…") with variables {{1}} order ID, {{2}} item,
# {{3}} total, {{4}} player UID, {{5}} customer WhatsApp, {{6}} order link.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_ORDER_TEMPLATE_SID=
